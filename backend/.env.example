APP_ENV=local
BACKEND_PORT=8000
REVIEW_PROVIDER=tencent_yuanqi_async
MAX_UPLOAD_SIZE_MB=20
MOCK_FAST_COMPLETE=false

PUBLIC_FILE_BASE_URL=http://127.0.0.1:8000
YUANQI_REQUEST_TIMEOUT_SECONDS=1000

# Legacy compatibility: chat/completions
YUANQI_API_URL=https://yuanqi.tencent.com/openapi/v1/agent/chat/completions
YUANQI_APP_ID=
YUANQI_APP_KEY=
YUANQI_API_KEY=
YUANQI_STREAM_DEFAULT=false
YUANQI_VARIABLES_FIELD_NAME=custom_variables

# Legacy compatibility: SSE provider
YUANQI_BOT_APP_KEY=
YUANQI_SSE_API_URL=https://wss.lke.cloud.tencent.com/v1/qbot/chat/sse
YUANQI_SSE_WORKFLOW_STATUS=enable
YUANQI_SSE_STREAM=enable
YUANQI_SSE_VISITOR_BIZ_ID=law_test_user
YUANQI_SSE_CONTRACT_TEXT_MAX_LENGTH=3000
YUANQI_SSE_OFFICIAL_MINIMAL_MODE=true

# Official mainline: workflow async API
YUANQI_ASYNC_ENDPOINT=https://lke.tencentcloudapi.com
YUANQI_ASYNC_SERVICE=lke
YUANQI_ASYNC_VERSION=2023-11-30
YUANQI_ASYNC_REGION=ap-guangzhou
YUANQI_ASYNC_RUN_ENV=1
YUANQI_ASYNC_INCLUDE_WORKFLOW_GRAPH=true
YUANQI_ASYNC_POLL_NODE_DETAILS=true
YUANQI_APP_BIZ_ID=
YUANQI_DEFAULT_VISITOR_BIZ_ID=law_self_user
YUANQI_TC_SECRET_ID=
YUANQI_TC_SECRET_KEY=
